---
import { buildCalendlyUrl } from '../utils/calendly-url.js';

interface Props {
	minWidth?: string;
	height?: string;
	/** UTM campaign for this embed (e.g. contact_inline, landing_2). */
	utmCampaign?: string;
	eventSlug?: string;
	utmContent?: string;
}

const {
	minWidth = '320px',
	height = '700px',
	utmCampaign = '',
	eventSlug = '',
	utmContent = '',
} = Astro.props;
const calendlyUrl = buildCalendlyUrl({ eventSlug, utmCampaign, utmContent });
---

<div
	class="calendly-inline-widget"
	data-url={calendlyUrl}
	style={`min-width:${minWidth};height:${height};`}
	aria-label="Schedule a meeting with Dr. Jan Duffy"
></div>
