---
import { Container, CtaCardSection } from '@components/odyssey-theme.js';
import HeadshotGallery from '../components/HeadshotGallery.astro';
import CalendlyLink from '../components/CalendlyLink.astro';
import Layout from '@layouts/Page.astro';
import HomeHeroSection from '@components/sections/heros/HomeHeroSection.astro';
import TextAndImageHero from '@components/sections/heros/TextAndImageHero.astro';
import TextCardSection from '@components/sections/TextCardSection.astro';
import CustomerQuoteSection from '@components/sections/CustomerQuoteSection.astro';
import ThreeColumnTextSection from '@components/sections/ThreeColumnTextSection.astro';
import RealScoutListings from '../components/RealScoutListings.astro';
import FAQSection from '@components/sections/FAQSection.astro';

const seo = {
  title: 'Consenza Estates New Homes | Las Vegas',
  description: 'Your premier specialist for Lennar homes in the exclusive Consenza Estates community in Las Vegas.',
};
---

<Layout {seo}>
  <TextAndImageHero reversed>
    <div slot="text-container" class="animate-in">
      <h1>Your Consenza Estates Specialist - Dr. Jan Duffy</h1>
      <p>Welcome to your premier resource for Consenza Estates real estate. As a specialized REALTOR® with extensive knowledge of Lennar homes and the Consenza Estates community, I'm here to guide you through every step of your real estate journey.</p>
      <div class="hero-buttons" style="display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.5rem;">
        <CalendlyLink class="agent-button" utmCampaign="home_hero">Book a free 15‑min call</CalendlyLink>
        <a href="/sell-your-home-to-buy-at-consenza-estates" class="agent-button" style="background: transparent; border: 2px solid var(--theme-primary); color: var(--theme-primary);">Sell to buy at Consenza</a>
        <a href="/properties" class="agent-button" style="background: transparent; border: 2px solid var(--theme-primary); color: var(--theme-primary);">View Listings</a>
      </div>
      <p class="hero-trust" style="margin-top: 0.75rem; font-size: 0.9rem; opacity: 0.9;">Free 15‑minute call — no obligation.</p>
    </div>
    <div slot="image-container">
      <picture>
        <img
          src="/assets/images/home/consenza-estates-hero.jpg"
          alt="Consenza Estates luxury homes"
          id="home-hero-image"
        />
      </picture>
    </div>
  </TextAndImageHero>

  <RealScoutListings sectionTitle="Featured Consenza Estates Listings" />

  <div style="background-color: var(--theme-surface-2); padding: 3rem 1rem; color: var(--theme-on-surface-2);">
    <Container>
      <h2 class="text-center" style="margin-bottom: 2rem; color: var(--theme-on-surface-2);">Consenza Estates Market Stats</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; text-align: center;">
        <div class="animate-in delay-1">
          <h3 class="stat-number">$850K</h3>
          <p style="font-size: 1.1rem;">Average Home Price</p>
        </div>
        <div class="animate-in delay-2">
          <h3 class="stat-number">14</h3>
          <p style="font-size: 1.1rem;">Average Days on Market</p>
        </div>
        <div class="animate-in delay-2">
          <h3 class="stat-number">98%</h3>
          <p style="font-size: 1.1rem;">List to Sale Price Ratio</p>
        </div>
        <div class="animate-in delay-3">
          <h3 class="stat-number">24</h3>
          <p style="font-size: 1.1rem;">Active Listings</p>
        </div>
      </div>
    </Container>
  </div>

  <div class="luxury-testimonials-container" style="padding: 3rem 1rem; background-color: var(--theme-surface-1);">
    <Container>
      <h2 class="text-center" style="margin-bottom: 2rem;">What Our Clients Say</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
        <div class="luxury-testimonial animate-in delay-1">
          <p style="font-style: italic; position: relative; z-index: 1;">"Dr. Duffy's expertise with Lennar homes in Consenza Estates was invaluable. She knew every detail about the community and helped us find our dream home."</p>
          <p style="font-weight: bold; margin-top: 1rem;">The Martinez Family</p>
        </div>
        <div class="luxury-testimonial animate-in delay-2">
          <p style="font-style: italic; position: relative; z-index: 1;">"We couldn't be happier with our Consenza Estates purchase. Dr. Duffy's in-depth knowledge of the neighborhood and Lennar construction made the process smooth and enjoyable."</p>
          <p style="font-weight: bold; margin-top: 1rem;">Robert & Susan Johnson</p>
        </div>
        <div class="luxury-testimonial animate-in delay-3">
          <p style="font-style: italic; position: relative; z-index: 1;">"Working with Dr. Duffy to sell our Consenza Estates home resulted in a quick sale above asking price. Her market knowledge is unmatched!"</p>
          <p style="font-weight: bold; margin-top: 1rem;">The Wilson Family</p>
        </div>
      </div>
    </Container>
  </div>

  <FAQSection heading="Consenza Estates FAQ" />

  <CtaCardSection
    background="var(--theme-surface-2)"
    color="var(--theme-on-surface-2)"
    callToAction={{
      text: 'Schedule a Private Tour',
      href: '/contact',
    }}
  >
    <h2>Ready to find your dream home in Consenza Estates?</h2>
    <p>Let me guide you through this community and help you discover the perfect Lennar home for your lifestyle.</p>
  </CtaCardSection>
  <Container>
    <HeadshotGallery />
  </Container>
</Layout>